// ============================================================================
//  UrbanSimDSL - Escenario: CAMPUS UNIVERSIDAD NACIONAL DEL ALTIPLANO (UNA) - PUNO
//  Archivo : UNA_Puno_Campus.usim
//  Fuente  : mapa de referencia del usuario (Jr. Jorge Basadre, Av. Sesquicentenario,
//            Jr. Selva Alegre, Jr. Jose de la Mar, Puerta de Ingenierias, Fac. de
//            Ingenieria Economica, Piscina UNA, UNAP) + ficha tecnica del proyecto
//            (limite 20 km/h, horas pico, Biblioteca, Rectorado, Estadio, parqueos).
//
//  CONVENCION DE COORDENADAS (puntos y posiciones)
//     - Unidad: metros. Escala del mapa: 1 px de la imagen = 1 m.
//     - Origen (0,0,0): centro aproximado del campus (pixel 380,355 de la imagen).
//     - x = este (+) / oeste (-)      z = sur (+) / norte (-)      y = elevacion relativa.
//     - Las vias del simulador son corredores independientes: cada interseccion
//       esta colocada EXACTAMENTE sobre un vertice de las vias que conecta, para que
//       el semaforo proyecte bien su linea de detencion.
//
//  LINEA DE TIEMPO (t = 0 equivale a las 06:45, hora pico de ingreso)
//     00-30 min  06:45-07:15  pre-pico       30-60 min  07:15-07:45  PICO
//     60-90 min  07:45-08:15  post-pico      (simulacion total: 90 min)
//
//  NOTA: puentes y semaforos son propuestas de diseno (el mapa no los muestra);
//        las posiciones de edificios no rotulados en el mapa son aproximadas.
// ============================================================================

// ---------------- Variables globales (se sustituyen por su valor en el JSON) ----------------
var v_campus = 20          // limite interno del campus (kmh)
var v_calle = 30           // calles perimetrales (kmh)
var v_avenida = 40         // Av. Sesquicentenario (kmh)
var ancho_calle = 3.25     // ancho de carril en calles (m)
var ancho_av = 3.5         // ancho de carril en avenidas (m)
var carriles_av = 4        // carriles totales de la Av. Sesquicentenario (entero)

// Plan semaforico A (campus): 30 + 4 + 26 = 60 s
var ciclo_a = 60
var verde_a = 30
var rojo_a = 26
// Plan semaforico B (avenida): 50 + 4 + 36 = 90 s
var ciclo_b = 90
var verde_b = 50
var rojo_b = 36
var amarillo_std = 4

// Flujos de hora pico (veh/h)
var flujo_sesqui_pico = 1150
var flujo_basadre_pico = 650
var flujo_campus_pico = 400

escenario "Simulacion_UNA_Puno_Campus" {
mapa "UNA_Puno_3D"


// ============================ VIAS ============================

// Limite oeste del campus (Puerta de Ingenierias). Arteria urbana.
via "Jr_Jorge_Basadre" {
  tipo avenida
  puntos [
    (-305, 0, -230),
    (-345, 0, -130),
    (-355, 0, -90),
    (-285, 0, -33),
    (-215, 0, 65),
    (-155, 0, 150),
    (-118, 0, 245),
    (-95, 0, 343)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_calle kmh
  capacidad 900 veh_h
}

// Limite sur-este. Eje de combis/colectivos. Incluye rampas y el puente sobre el canal.
via "Av_Sesquicentenario" {
  tipo avenida
  puntos [
    (-95, 0, 343),
    (-2, 0, 313),
    (60, 0, 277),
    (90, 3, 262),
    (150, 3, 233),
    (185, 0, 217),
    (260, 0, 173),
    (370, 0, 100)
  ]
  carriles carriles_av
  ancho_carril ancho_av m
  sentido doble
  velocidad_max v_avenida kmh
  capacidad 2000 veh_h
}

// Limite este del campus.
via "Jr_Jose_de_la_Mar" {
  tipo calle
  puntos [
    (370, 0, 100),
    (355, 0, 47),
    (335, 0, -10),
    (315, 0, -35)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_calle kmh
  capacidad 700 veh_h
}

// Limite nor-este.
via "Jr_Selva_Alegre" {
  tipo calle
  puntos [
    (165, 0, -67),
    (200, 0, -37),
    (315, 0, -35)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_calle kmh
  capacidad 700 veh_h
}

// Eje interno principal oeste-este: Puerta de Ingenierias -> Biblioteca -> Piscina -> Jr. Jose de la Mar.
via "Av_Universitaria" {
  tipo avenida
  puntos [
    (-285, 0, -33),
    (-220, 0, -5),
    (-150, 0, 27),
    (-53, 0, 37),
    (15, 0, 40),
    (100, 0, 31),
    (175, 0, 47),
    (235, 0, 85),
    (310, 0, 93),
    (355, 0, 47)
  ]
  carriles 2
  ancho_carril ancho_av m
  sentido doble
  velocidad_max v_campus kmh
  capacidad 800 veh_h
}

// Columna vertebral norte-sur del campus (Rectorado -> acceso sur).
via "Eje_Central_Sur" {
  tipo calle
  puntos [
    (-50, 0, -17),
    (-53, 0, 37),
    (-54, 0, 65),
    (-64, 0, 145),
    (-80, 0, 235),
    (-95, 0, 343)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_campus kmh
  capacidad 600 veh_h
}

// Anillo de facultades del sector norte.
via "Anillo_Norte" {
  tipo calle
  puntos [
    (-135, 0, -97),
    (-80, 0, -117),
    (23, 0, -117),
    (100, 0, -103),
    (165, 0, -67)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_campus kmh
  capacidad 600 veh_h
}

// Acceso norte al Estadio Universitario (con puente).
via "Acceso_Norte_Estadio" {
  tipo calle
  puntos [
    (-35, 0, -285),
    (40, 0, -300),
    (82, 0, -287),
    (98, 3, -273),
    (117, 3, -230),
    (132, 0, -187),
    (140, 0, -155),
    (165, 0, -67)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_calle kmh
  capacidad 700 veh_h
}

// Eje vertical este (Biblioteca - Biomedicas - Estadio).
via "Eje_Biomedicas" {
  tipo calle
  puntos [
    (25, 0, -215),
    (23, 0, -117),
    (22, 0, -35),
    (15, 0, 40)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_campus kmh
  capacidad 500 veh_h
}

// Salida sur desde Piscina/UNAP hacia Av. Sesquicentenario.
via "Via_UNAP_Sesquicentenario" {
  tipo calle
  puntos [
    (175, 0, 47),
    (172, 0, 107),
    (178, 0, 165),
    (185, 0, 217)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_campus kmh
  capacidad 500 veh_h
}

// Via de servicio de un solo sentido (comedor, coliseo, abastecimiento).
via "Via_Logistica_Sur" {
  tipo calle
  puntos [
    (-64, 0, 145),
    (0, 0, 147),
    (58, 0, 143),
    (68, 0, 205),
    (60, 0, 277)
  ]
  carriles 1
  ancho_carril ancho_av m
  sentido unico
  velocidad_max v_campus kmh
  capacidad 400 veh_h
}

// Calle exterior noroeste (sector Sinai).
via "Jr_Sinai" {
  tipo calle
  puntos [
    (-305, 0, -230),
    (-215, 0, -237),
    (-165, 0, -260),
    (-135, 0, -295)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_calle kmh
  capacidad 300 veh_h
}

// Conexion Facultades de Ingenieria -> Anillo Norte.
via "Via_Ingenierias_Norte" {
  tipo calle
  puntos [
    (-220, 0, -5),
    (-202, 0, -55),
    (-190, 0, -97),
    (-135, 0, -97)
  ]
  carriles 2
  ancho_carril ancho_calle m
  sentido doble
  velocidad_max v_campus kmh
  capacidad 500 veh_h
}

// ================== INTERSECCIONES Y SEMAFOROS ==================
// 'anidado' = semaforo declarado dentro de la interseccion; 'externo' = semaforo
// independiente que referencia la interseccion con  interseccion "..."

interseccion "Int_Sinai_Basadre" {
  posicion (-305, 0, -230)
  conecta "Jr_Jorge_Basadre"
  conecta "Jr_Sinai"
}

interseccion "Int_Puerta_Ingenierias" {
  posicion (-285, 0, -33)
  conecta "Jr_Jorge_Basadre"
  conecta "Av_Universitaria"
  semaforo "Sem_Puerta_Ingenierias" {
    ciclo ciclo_a s
    fase verde { duracion verde_a s }
    fase amarillo { duracion amarillo_std s }
    fase rojo { duracion rojo_a s }
  }
}

interseccion "Int_Ingenierias_Norte" {
  posicion (-220, 0, -5)
  conecta "Av_Universitaria"
  conecta "Via_Ingenierias_Norte"
}

interseccion "Int_Central" {
  posicion (-53, 0, 37)
  conecta "Av_Universitaria"
  conecta "Eje_Central_Sur"
  semaforo "Sem_Central" {
    ciclo ciclo_a s
    fase verde { duracion verde_a s }
    fase amarillo { duracion amarillo_std s }
    fase rojo { duracion rojo_a s }
  }
}

interseccion "Int_Biomedicas" {
  posicion (15, 0, 40)
  conecta "Av_Universitaria"
  conecta "Eje_Biomedicas"
}

interseccion "Int_Norte_Biomedicas" {
  posicion (23, 0, -117)
  conecta "Anillo_Norte"
  conecta "Eje_Biomedicas"
}

interseccion "Int_Piscina" {
  posicion (175, 0, 47)
  conecta "Av_Universitaria"
  conecta "Via_UNAP_Sesquicentenario"
  semaforo "Sem_Piscina" {
    ciclo ciclo_a s
    fase verde { duracion verde_a s }
    fase amarillo { duracion amarillo_std s }
    fase rojo { duracion rojo_a s }
  }
}

interseccion "Int_Selva_Alegre" {
  posicion (165, 0, -67)
  conecta "Anillo_Norte"
  conecta "Acceso_Norte_Estadio"
  conecta "Jr_Selva_Alegre"
}

interseccion "Int_Servicio_Central" {
  posicion (-64, 0, 145)
  conecta "Eje_Central_Sur"
  conecta "Via_Logistica_Sur"
}

interseccion "Int_Sesqui_Servicio" {
  posicion (60, 0, 277)
  conecta "Av_Sesquicentenario"
  conecta "Via_Logistica_Sur"
}

interseccion "Int_Sesqui_UNAP" {
  posicion (185, 0, 217)
  conecta "Av_Sesquicentenario"
  conecta "Via_UNAP_Sesquicentenario"
  semaforo "Sem_Sesqui_UNAP" {
    ciclo ciclo_b s
    fase verde { duracion verde_b s }
    fase amarillo { duracion amarillo_std s }
    fase rojo { duracion rojo_b s }
  }
}

interseccion "Int_Rotonda_Sur" {
  posicion (-95, 0, 343)
  conecta "Jr_Jorge_Basadre"
  conecta "Av_Sesquicentenario"
  conecta "Eje_Central_Sur"
}

interseccion "Int_JdlM_Sesqui" {
  posicion (370, 0, 100)
  conecta "Av_Sesquicentenario"
  conecta "Jr_Jose_de_la_Mar"
}

interseccion "Int_JdlM_Universitaria" {
  posicion (355, 0, 47)
  conecta "Av_Universitaria"
  conecta "Jr_Jose_de_la_Mar"
}

interseccion "Int_JdlM_Selva" {
  posicion (315, 0, -35)
  conecta "Jr_Jose_de_la_Mar"
  conecta "Jr_Selva_Alegre"
}

semaforo "Sem_Biomedicas" {
  interseccion "Int_Biomedicas"
  ciclo 75 s
  fase verde { duracion 40 s }
  fase amarillo { duracion 5 s }
  fase rojo { duracion 30 s }
}

semaforo "Sem_Sesqui_Servicio" {
  interseccion "Int_Sesqui_Servicio"
  ciclo ciclo_b s
  fase verde { duracion verde_b s }
  fase amarillo { duracion amarillo_std s }
  fase rojo { duracion rojo_b s }
}

// ============================ PUENTES ============================
// y = 3 m en los vertices de la via que cubre el puente (rampas de acceso).

// Cruce de la quebrada/canal de drenaje en el acceso norte al estadio
puente "Puente_Acceso_Estadio" {
  tipo vehicular
  posicion (108, 3, -252)
  orientacion 66 grados
  sobre "Acceso_Norte_Estadio"
  geometria { longitud 48 m ancho 9 m altura 3 m }
  calzada { carriles 2 ancho_carril 3.5 m sentido doble velocidad_max 30 kmh capacidad 700 veh_h }
  estructura { tablero 0.5 m apoyo 3 }
}

// Cruce del canal de drenaje sobre la Av. Sesquicentenario (4 carriles)
puente "Puente_Canal_Sesquicentenario" {
  tipo vehicular
  posicion (120, 3, 248)
  orientacion 334 grados
  sobre "Av_Sesquicentenario"
  geometria { longitud 68 m ancho 16 m altura 3 m }
  calzada { carriles 4 ancho_carril 3.5 m sentido doble velocidad_max 40 kmh capacidad 2000 veh_h }
  estructura { tablero 0.6 m apoyo 5 }
}

