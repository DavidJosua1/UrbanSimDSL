  duracion 10 min
}
// Bloqueo en la avenida interna durante el post-pico
evento "Accidente_Av_Universitaria" {
  tipo accidente
  via "Av_Universitaria"
  carril 1
  inicio 65 min
  duracion 8 min
}

// ============================ CLIMA ============================
// Inicio de temporada de lluvias en Puno. Para un dia seco: estado despejado / visibilidad 100 %
clima {
  estado lluvia
  intensidad baja
  visibilidad 85 %
}

// ============================ SIMULACION ============================
simulacion {
  duracion 90 min
  intervalo 1 s
  repeticiones 5
}
}
